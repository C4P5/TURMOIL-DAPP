# Copy to .env.local and fill in. Never commit .env.local.

# Privy app id — dashboard.privy.io. Without it, login and signing are disabled
# and the app renders a banner saying so.
NEXT_PUBLIC_PRIVY_APP_ID=

# Deployed Turmoil.sol address. Printed by:
#   forge script script/Deploy.s.sol --tc Deploy --rpc-url <rpc> --broadcast
NEXT_PUBLIC_TURMOIL_ADDRESS=0x0000000000000000000000000000000000000000

# 296 = Hedera testnet. Must match the chainId baked into the EIP-712 domain,
# or every signature recovers to a stranger and attest() reverts.
NEXT_PUBLIC_CHAIN_ID=296
NEXT_PUBLIC_HEDERA_RPC=https://testnet.hashio.io/api

# Relayer key — submits batches both parties already signed. Holds no authority
# of its own: attest() verifies both signatures on chain, so a leaked relayer key
# can forge nothing and replay nothing. It can only waste its own gas.
# In production this key lives on the collector's device.
RELAYER_PRIVATE_KEY=

# --- The company (collector) wallet -----------------------------------------
# TURMOIL signs the collector half of every pickup from ONE Privy server wallet,
# not from the driver's phone: drivers change, the company's signing identity and
# its posted bond do not.

# Privy app secret — dashboard.privy.io, App settings > API keys. A real secret.
PRIVY_APP_SECRET=

# The server wallet's Privy id, and the address it signs as. The address must be
# registered with setCollector() and hold a bond, or attest() reverts.
PRIVY_WALLET_ID=
PRIVY_COLLECTOR_ADDRESS=0x0000000000000000000000000000000000000000

# The same address again, for the browser: the pickup screen lists this truck's
# own history, which means filtering batches by collector before any signature
# exists. Public chain data either way.
NEXT_PUBLIC_COLLECTOR_ADDRESS=0x0000000000000000000000000000000000000000

# Emails allowed to trigger a company signature, comma separated.
# UNSET MEANS NOBODY. Defaulting an empty list to "any authenticated user" would
# let a missing variable quietly turn the company wallet into a public signing
# service, and the failure would look exactly like everything working.
DRIVERS=
