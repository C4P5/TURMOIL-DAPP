# Copy to .env.local and fill in. Never commit .env.local.

# Privy app id — dashboard.privy.io. Without it, login and signing are disabled
# and the app renders a banner saying so.
NEXT_PUBLIC_PRIVY_APP_ID=

# Deployed Turmoil.sol address. Printed by:
#   forge script script/Deploy.s.sol --tc Deploy --rpc-url <rpc> --broadcast
NEXT_PUBLIC_TURMOIL_ADDRESS=0x0000000000000000000000000000000000000000

# 296 = Hedera testnet. Must match the chainId baked into the EIP-712 domain,
# or every signature recovers to a stranger and attest() reverts.
NEXT_PUBLIC_CHAIN_ID=296
NEXT_PUBLIC_HEDERA_RPC=https://testnet.hashio.io/api

# Relayer key — submits batches both parties already signed. Holds no authority
# of its own: attest() verifies both signatures on chain, so a leaked relayer key
# can forge nothing and replay nothing. It can only waste its own gas.
# In production this key lives on the collector's device.
RELAYER_PRIVATE_KEY=
