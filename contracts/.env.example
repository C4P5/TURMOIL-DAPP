# Copy to .env and fill in. Never commit .env — it is gitignored.

# Hedera testnet account key from portal.hedera.com.
# ECDSA (secp256k1), NOT ED25519 — the EVM tooling cannot use an ED25519 key.
PRIVATE_KEY=

# Resolved by the `hedera_testnet` alias in foundry.toml.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Settlement token. Unset deploys a 6-decimal DemoUSDC and mints an escrow float,
# which is the right choice for a local anvil run. Set, it binds the real token.
# Below is Circle's USDC on Hedera testnet (0.0.429274) as its ERC-20 facade:
# FUNGIBLE_COMMON, 6 decimals, no KYC key, verified on the mirror node.
SETTLEMENT_TOKEN=0x0000000000000000000000000000000000068cDa

# Optional. If set, the deploy registers them straight away.
RESTAURANT=
COLLECTOR=
